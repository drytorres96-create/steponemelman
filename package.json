{
  "name": "steponemelman",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "Plataforma adaptativa de estudio para USMLE Step 1 construida sobre un corpus médico auditado",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:nube": "vitest run src/__tests__/sync.test.ts src/__tests__/estado-model.test.ts src/auth --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
