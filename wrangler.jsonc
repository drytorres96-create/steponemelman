{
  "name": "steponemelman",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "main": "src/server/worker.ts",
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "COACH", "class_name": "StudyCoach" }] },
  "migrations": [{ "tag": "coach-v1", "new_sqlite_classes": ["StudyCoach"] }],
  "vars": { "AI_FREE_ENABLED": "true" },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
