/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://rcwvwxchpukjbtqsrxfi.supabase.co wss://rcwvwxchpukjbtqsrxfi.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Vite pone un hash en cada nombre: el contenido de /assets nunca cambia bajo el mismo nombre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Original decorative artwork, versioned so a future design cannot reuse stale files.
/images/v170/*
  Cache-Control: public, max-age=31536000, immutable

/images/v171/*
  Cache-Control: public, max-age=31536000, immutable

# Tipografía propia: la política de seguridad solo admite recursos de este origen.
/fonts/*
  Cache-Control: public, max-age=604800

/icon-192.png
  Cache-Control: public, max-age=0, must-revalidate
/icon-512.png
  Cache-Control: public, max-age=0, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Identidad orbital de Melman; nombres nuevos para evitar el icono antiguo de iOS.
/brand-icon-v127.svg
  Cache-Control: public, max-age=31536000, immutable
/brand-v127-180.png
  Cache-Control: public, max-age=31536000, immutable
/brand-v127-192.png
  Cache-Control: public, max-age=31536000, immutable
/brand-v127-512.png
  Cache-Control: public, max-age=31536000, immutable
